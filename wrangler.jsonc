{
  // Cloudflare Workers / Pages 静态资源部署配置
  // 本项目是纯前端 SPA，没有后端 Worker 脚本，仅托管 dist 静态产物
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tomato-clock",
  // 建议保持为“今天”的日期，以便使用最新的运行时默认行为
  "compatibility_date": "2026-10-01",
  "assets": {
    // npm run build 的输出目录
    "directory": "./dist",
    // 未命中静态资源时返回 index.html，交给 React Router 处理前端路由
    // 必须显式声明，且仓库刻意不放 public/_redirects：
    // "/* /index.html 200" 会被 Cloudflare 判为无限循环并在部署时拒绝
    // （Invalid _redirects configuration, code 100324），SPA 回退只能靠这里
    "not_found_handling": "single-page-application",
  },
}
